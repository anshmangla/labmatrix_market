generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Lets the schema declare pg_trgm below, so `prisma db push` creates it on a fresh database
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Trigram matching: lets the GIN indexes below serve "contains" (ILIKE '%term%') searches
  extensions = [pg_trgm]
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  AVAILABLE
  PENDING
  SOLD
}

enum RequirementStatus {
  OPEN
  FULFILLED
  CLOSED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phoneNumber   String?
  companyName   String?
  role          Role          @default(USER)
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  requirements  Requirement[]
  inquiries     Inquiry[]
  notifications Notification[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Listing {
  id             String        @id @default(cuid())
  title          String
  description    String
  category       String
  itemType       String        @default("MACHINE")
  partNumber     String?
  compatibleWith String?
  minPrice       Float
  maxPrice       Float
  condition      String?       @default("Used - Good")
  location       String?
  photos         String[]      @default([])
  quantity       Int           @default(1)
  status         ListingStatus @default(AVAILABLE)
  isApproved     Boolean       @default(false)
  sellerId       String
  seller         User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  inquiries      Inquiry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Public feeds, newest first. createdAt comes before status so the feed's
  // "status IN (AVAILABLE, SOLD)" filter can still read the index in order and stop at the page size.
  @@index([isApproved, createdAt(sort: Desc), status])
  @@index([isApproved, itemType, createdAt(sort: Desc), status])
  // Seller's own items, "received" inquiries join, and cascade deletes
  @@index([sellerId, createdAt(sort: Desc)])
  // Marketplace search matches any of these four columns with "contains"
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([partNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([compatibleWith(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Requirement {
  id             String            @id @default(cuid())
  title          String
  description    String
  category       String
  itemType       String            @default("MACHINE")
  partNumber     String?
  compatibleWith String?
  status         RequirementStatus @default(OPEN)
  isApproved     Boolean           @default(false)
  buyerId        String
  buyer          User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  inquiries      Inquiry[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Public request feed: approved + open, newest first
  @@index([isApproved, status, createdAt(sort: Desc)])
  // Buyer's own requests, "received" inquiries join, and cascade deletes
  @@index([buyerId, createdAt(sort: Desc)])
  // Request search matches any of these four columns with "contains"
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([partNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([compatibleWith(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Inquiry {
  id            String        @id @default(cuid())
  inquirerId    String
  inquirer      User          @relation(fields: [inquirerId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   Requirement?  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  message       String
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([inquirerId, createdAt(sort: Desc)])
  @@index([listingId])
  @@index([requirementId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
}
